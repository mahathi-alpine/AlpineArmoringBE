+// Reason: showdown treats <div>...</div> as an opaque raw-HTML block and skips
+// markdown parsing of its contents (e.g. pipe tables) unless the tag carries a
+// markdown="1" attribute. Content editors wrap tables in <div class="..."> for
+// CSS styling, so mark only divs whose content actually contains a markdown
+// table (detected via its header separator row, e.g. "| --- | --- |") to
+// avoid reinterpreting unrelated div content as markdown.
+const TABLE_SEPARATOR_RE = /^\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)+\|?\s*$/m
+
+function markDivsAsMarkdown(text) {
+  if (!text.includes('<div')) return text
+  return text.replace(
+    /<div(\s[^>]*)?>([\s\S]*?)<\/div>/gi,
+    (match, attrs, inner) => {
+      if (attrs && /\bmarkdown\s*=\s*["']?1["']?/i.test(attrs)) return match
+      if (!TABLE_SEPARATOR_RE.test(inner)) return match
+      return `<div${attrs || ''} markdown="1">${inner}</div>`
+    }
+  )
+}
